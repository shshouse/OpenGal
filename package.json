{
  "name": "opengal",
  "version": "0.0.1",
  "description": "OpenGal,the best harness specifically for digital life",
  "main": "./out/main/index.js",
  "author": "shshouse",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "chcp 65001 && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "selfcheck": "node --experimental-strip-types src/scripts/selfcheck/selfcheck-ttsport.ts && node --experimental-strip-types src/scripts/selfcheck/selfcheck-mcp.ts && node --experimental-strip-types src/scripts/selfcheck/selfcheck-stream.ts && node --experimental-strip-types src/scripts/selfcheck/selfcheck-memory.ts",
    "package": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@huggingface/transformers": "^4.2.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.1",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "electron-store": "^8.2.0",
    "lucide-react": "^0.460.0",
    "onnxruntime-node": "^1.24.3",
    "pixi-live2d-display-lipsyncpatch": "^0.5.0-ls-8",
    "pixi.js": "^7.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "tiktoken": "^1.0.22",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^44.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.opengal.app",
    "productName": "OpenGal",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/models",
        "to": "models",
        "filter": [
          "bge-small-zh-v1.5/**/*",
          "!bge-small-zh-v1.5/onnx/model.onnx",
          "asr/**/*"
        ]
      },
      {
        "from": "resources/tts",
        "to": "tts"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "public/Logo/icon.png"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "asarUnpack": [
      "**/node_modules/onnxruntime-node/**"
    ]
  }
}
