{
  "name": "OpenGal",
  "version": "0.0.1",
  "description": "OpenGal,the best harness specifically for digital life",
  "main": "./out/main/index.js",
  "author": "shshouse",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc -p config/tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p config/tsconfig.web.json --noEmit",
    "typecheck:test": "tsc -p config/tsconfig.test.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "test": "vitest run --config config/vitest.config.ts",
    "test:watch": "vitest --config config/vitest.config.ts",
    "test:coverage": "vitest run --config config/vitest.config.ts --coverage",
    "eval:memory": "node --experimental-strip-types src/scripts/memory-eval.ts",
    "lint": "eslint . --config config/eslint.config.mjs",
    "lint:fix": "eslint . --config config/eslint.config.mjs --fix",
    "build:app": "electron-vite build",
    "release:win": "electron-vite build && electron-builder --win zip --publish never",
    "check:complexity": "node src/scripts/check-complexity.mjs",
    "check:complexity:update": "node src/scripts/check-complexity.mjs --update"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.1",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "fast-glob": "^3.3.3",
    "geist-icons": "^1.3.0",
    "lucide-react": "^0.460.0",
    "onnxruntime-node": "^1.24.3",
    "p-retry": "^8.0.1",
    "pixi-live2d-display-lipsyncpatch": "^0.5.0-ls-8",
    "pixi.js": "^7.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.1"
  },
  "optionalDependencies": {
    "get-windows": "^9.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.20",
    "electron": "^45.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.10",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "node-abi": "^4.35.0"
  },
  "build": {
    "appId": "com.opengal.app",
    "productName": "OpenGal",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
    ],
    "asarUnpack": [
      "**/node_modules/get-windows/**",
      "**/node_modules/onnxruntime-node/**"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "public/Logo/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/models",
        "to": "models",
        "filter": [
          "bge-small-zh-v1.5/**/*",
          "!bge-small-zh-v1.5/onnx/model.onnx",
          "asr/**/*"
        ]
      },
      {
        "from": "resources/asr",
        "to": "asr"
      },
      {
        "from": "resources/tts",
        "to": "tts"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "public/Logo/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "shshouse",
        "repo": "OpenGal",
        "releaseType": "release"
      }
    ]
  }
}
