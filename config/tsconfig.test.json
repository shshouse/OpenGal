{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["node", "electron", "vite/client"],
    "baseUrl": "..",
    "paths": {
      "@/*": ["src/renderer/src/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": [
    "../tests/**/*.ts",
    "./vitest.config.ts",
    "../src/preload/api.d.ts",
    "../src/main/types/raw.d.ts"
  ]
}
