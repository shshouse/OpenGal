{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["../../src/renderer/src/*"],
      "@shared/*": ["../../src/shared/*"]
    }
  },
  "include": ["src/**/*", "../../src/shared/**/*", "../../src/preload/api.d.ts"]
}
